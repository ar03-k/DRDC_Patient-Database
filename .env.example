DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=
DJANGO_SECURE_PROXY_SSL_HEADER=False
DJANGO_HSTS_SECONDS=0
DJANGO_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_HSTS_PRELOAD=False

# Keep sqlite for the current local database; set to postgresql for a local PostgreSQL server.
DB_ENGINE=sqlite
DB_NAME=dental_clinic
DB_USER=dental_clinic
DB_PASSWORD=replace-with-a-local-only-password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60

# Leave unset for local filesystem uploads. For production, configure a private bucket.
OBJECT_STORAGE_BUCKET_NAME=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ENDPOINT_URL=
